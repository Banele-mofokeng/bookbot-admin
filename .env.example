# ── Admin frontend (build-time) ──────────────────────────────────────────────
# URL of your FastAPI bot — no trailing slash. Set it as a variable on the
# frontend service; Railway passes it to the Docker build, where Vite compiles
# it into the bundle.
#
# Build-time, not runtime: changing it does nothing until the service is
# rebuilt. There is no fallback — the build fails if this is missing, rather
# than shipping a dashboard that loads fine and talks to nothing.
VITE_API_URL=https://<your-bot>.up.railway.app


# ── Bot service ──────────────────────────────────────────────────────────────
# Set these on the bot service, not the frontend. DEPLOY.md explains what each
# one does and what happens when it's missing.

# On Railway use reference variables rather than pasted connection strings, so a
# rotated database password reaches the bot on its own:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
# Either postgres:// or postgresql:// works — app/config.py rewrites the former.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/railway
REDIS_URL=redis://default:<password>@<host>:6379

# REQUIRED — signs login tokens. Auth returns 503 without it.
JWT_SECRET=<openssl rand -hex 32>
JWT_EXP_HOURS=12

# REQUIRED — authenticates Evolution's /webhook calls. Comma-separated so the
# secret can be rotated with no downtime. Empty leaves /webhook world-open.
WEBHOOK_SECRET=<openssl rand -hex 32>

# Seeded on boot if the account doesn't exist yet.
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=<strong-password>

# CORS allow-list. Comma-separated; defaults to "*" — set it in production.
ALLOWED_ORIGINS=https://<your-admin>.up.railway.app

TZ=Africa/Johannesburg

# Ordering adds no environment variables. Whether a business takes queue
# bookings or takeaway orders, its currency, and its kitchen throughput are all
# per-business settings on the tenant row, edited in the dashboard.
