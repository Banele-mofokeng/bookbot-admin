# ── Admin frontend (build arg) ───────────────────────────────────────────────
# URL of your FastAPI bot — no trailing slash
# In EasyPanel, set this to your bot service's public URL
VITE_API_URL=https://your-bot-url.easypanel.host


# ── Bot service ──────────────────────────────────────────────────────────────
# Set these on the `whatsapp-bot` service, not the frontend. DEPLOY.md explains
# what each one does and what happens when it's missing.

DATABASE_URL=postgres://postgres:<password>@<project>_booking-db:5432/whatsapp_bot
REDIS_URL=redis://default:<password>@<project>_evolution-api-redis:6379

# REQUIRED — signs login tokens. Auth returns 503 without it.
JWT_SECRET=<openssl rand -hex 32>
JWT_EXP_HOURS=12

# REQUIRED — authenticates Evolution's /webhook calls. Comma-separated so the
# secret can be rotated with no downtime. Empty leaves /webhook world-open.
WEBHOOK_SECRET=<openssl rand -hex 32>

# Seeded on boot if the account doesn't exist yet.
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=<strong-password>

# CORS allow-list. Comma-separated; defaults to "*" — set it in production.
ALLOWED_ORIGINS=https://your-admin-url.easypanel.host

TZ=Africa/Johannesburg

# Ordering adds no environment variables. Whether a business takes queue
# bookings or takeaway orders, its currency, and its kitchen throughput are all
# per-business settings on the tenant row, edited in the dashboard.
