FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN chmod +x ./node_modules/.bin/vite

# The bot's public URL. Vite compiles this into the bundle, so it is fixed at
# build time and a later change to the variable does nothing until a rebuild.
#
# No default, and the build stops if it is missing. A default is worse than it
# looks here: the bundle would build cleanly, the container would serve, the
# dashboard would load, and every request would go to whatever host the default
# named — a failure that shows up as an empty dashboard rather than as an error.
# Failing during the build costs a deploy; the old container keeps serving until
# a good one replaces it.
#
# The check itself lives in scripts/require-api-url.mjs, shared with the
# Cloudflare build, so both paths refuse to build without it and say the same
# thing when they do.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build:deploy

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
