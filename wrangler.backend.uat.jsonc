{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookbot-api-uat",
  "compatibility_date": "2026-10-21",
  "main": "worker/api.js",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "BotContainer",
      "image": "./Dockerfile.bot",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT",
        "class_name": "BotContainer"
      }
    ]
  },
  "exports": {
    "BotContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
